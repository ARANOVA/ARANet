generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model aranet_address {
  id                   Int                    @id @default(autoincrement())
  address_line1        String?                @db.VarChar(255)
  address_line2        String?                @db.VarChar(255)
  address_location     String?                @db.VarChar(128)
  address_state        String?                @db.VarChar(64)
  address_postal_code  String?                @db.VarChar(10)
  address_country      String?                @db.VarChar(2)
  address_distance     Int?
  aranet_objectaddress aranet_objectaddress[]
}

model aranet_budget {
  id                                                    Int                        @id @default(autoincrement())
  budget_prefix                                         String?                    @db.VarChar(8)
  budget_number                                         String                     @db.VarChar(11)
  budget_revision                                       Int                        @default(0)
  budget_date                                           DateTime                   @db.Date
  budget_valid_date                                     DateTime                   @db.Date
  budget_approved_date                                  DateTime?                  @db.Date
  budget_client_id                                      Int?
  budget_project_id                                     Int?
  budget_category_id                                    Int?
  budget_title                                          String?                    @db.VarChar(255)
  budget_comments                                       String?                    @db.Text
  budget_print_comments                                 Int?                       @default(0)
  budget_tax_rate                                       Float?                     @default(0)
  budget_freight_charge                                 Float?                     @default(0)
  budget_total_cost                                     Float?                     @default(0)
  budget_total_amount                                   Float?                     @default(0)
  budget_payment_condition_id                           Int?
  budget_status_id                                      Int?                       @default(0)
  budget_is_last                                        Int?                       @default(1)
  created_at                                            DateTime?                  @db.DateTime(0)
  created_by                                            Int?
  updated_at                                            DateTime?                  @db.DateTime(0)
  updated_by                                            Int?
  deleted_at                                            DateTime?                  @db.DateTime(0)
  deleted_by                                            Int?
  aranet_budget_status                                  aranet_budget_status?      @relation(fields: [budget_status_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "aranet_budget_FK_1")
  sf_guard_user_aranet_budget_created_byTosf_guard_user sf_guard_user?             @relation("aranet_budget_created_byTosf_guard_user", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "aranet_budget_FK_2")
  sf_guard_user_aranet_budget_updated_byTosf_guard_user sf_guard_user?             @relation("aranet_budget_updated_byTosf_guard_user", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "aranet_budget_FK_3")
  sf_guard_user_aranet_budget_deleted_byTosf_guard_user sf_guard_user?             @relation("aranet_budget_deleted_byTosf_guard_user", fields: [deleted_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "aranet_budget_FK_4")
  aranet_invoice_category                               aranet_invoice_category?   @relation(fields: [budget_category_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "budget_category_id_idx")
  aranet_client                                         aranet_client?             @relation(fields: [budget_client_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "budget_client_id_idx")
  aranet_payment_condition                              aranet_payment_condition?  @relation(fields: [budget_payment_condition_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "budget_payment_condition_id_idx")
  aranet_project                                        aranet_project?            @relation(fields: [budget_project_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "budget_project_id_idx")
  aranet_budget_item                                    aranet_budget_item[]
  aranet_expense_item                                   aranet_expense_item[]
  aranet_income_item                                    aranet_income_item[]
  aranet_invoice                                        aranet_invoice[]
  aranet_project_milestone                              aranet_project_milestone[]
  aranet_project_task                                   aranet_project_task[]
  aranet_timesheet                                      aranet_timesheet[]

  @@index([budget_category_id], map: "FI_get_category_id_idx")
  @@index([budget_payment_condition_id], map: "FI_get_payment_condition_id_idx")
  @@index([budget_status_id], map: "aranet_budget_FI_1")
  @@index([created_by], map: "aranet_budget_FI_2")
  @@index([updated_by], map: "aranet_budget_FI_3")
  @@index([deleted_by], map: "aranet_budget_FI_4")
  @@index([budget_client_id], map: "budget_client_id_index")
  @@index([budget_number], map: "budget_number_idx")
  @@index([budget_project_id], map: "budget_project_id_index")
}

model aranet_budget_item {
  id                          Int                          @id @default(autoincrement())
  item_order                  Int                          @default(0)
  item_type_id                Int?
  item_is_optional            Int?                         @default(0)
  item_description            String?                      @db.Text
  item_quantity               Float?                       @default(0)
  milestone_task_id           Int?
  item_task_id                Int?
  item_cost                   Float?                       @default(0)
  item_margin                 Float?                       @default(0)
  item_retail_price           Float?                       @default(0)
  item_tax_rate               Float?                       @default(0)
  item_budget_id              Int?
  item_budget_type_id         Int?
  aranet_type_of_invoice_item aranet_type_of_invoice_item? @relation(fields: [item_type_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "aranet_budget_item_FK_1")
  aranet_budget               aranet_budget?               @relation(fields: [item_budget_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "aranet_budget_item_FK_2")
  aranet_type_of_hour         aranet_type_of_hour?         @relation(fields: [item_budget_type_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "aranet_budget_item_FK_3")

  @@index([item_budget_type_id], map: "aranet_budget_item_FI_3")
  @@index([item_budget_id], map: "item_budget_id_idx2")
  @@index([item_type_id], map: "item_type_id_idx2")
}

model aranet_budget_status {
